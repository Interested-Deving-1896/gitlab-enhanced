# --- IPFS / Helia (JS, upstream) ---
[submodule "ipfs/helia/verified-fetch"]
	path = ipfs/helia/verified-fetch
	url = https://github.com/ipfs/helia-verified-fetch.git
	branch = main

[submodule "ipfs/helia/remote-pinning"]
	path = ipfs/helia/remote-pinning
	url = https://github.com/ipfs/helia-remote-pinning.git
	branch = main

[submodule "ipfs/service-worker-gateway"]
	path = ipfs/service-worker-gateway
	url = https://github.com/ipfs/service-worker-gateway.git
	branch = main

# --- CI tooling (upstream CLIs) ---
[submodule "ci/graphite/cli"]
	path = ci/graphite/cli
	url = https://github.com/withgraphite/graphite-cli.git
	branch = main

# --- Dev environment (upstream, consumed) ---
[submodule "environments/openvscode-server"]
