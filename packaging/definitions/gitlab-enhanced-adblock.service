[Unit]
Description=gitlab-enhanced adblock proxy service
Documentation=https://gitlab.com/openos-project/git-management_deving/gitlab-enhanced
After=network.target
ConditionPathExists=/etc/gitlab-enhanced/local.yaml

[Service]
Type=simple
User=gitlab-enhanced
Group=gitlab-enhanced
EnvironmentFile=-/etc/gitlab-enhanced/adblock.env
ExecStart=/usr/local/bin/adblock-proxy --config /etc/gitlab-enhanced/local.yaml
ExecStartPost=/bin/sh -c 'until curl -sf http://127.0.0.1:6060/health > /dev/null; do sleep 1; done'
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60s
StartLimitBurst=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gitlab-enhanced /etc/adblock-proxy

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gitlab-enhanced-adblock

[Install]
WantedBy=multi-user.target
