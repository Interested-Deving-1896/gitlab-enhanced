# =============================================================================
# SUBTREES — projects we own/fork and modify directly
# Format: <local-path> <remote-url> <branch>
#
# To add a subtree:
#   git subtree add --prefix=<path> <remote> <branch> --squash
#
# To sync upstream changes:
#   git subtree pull --prefix=<path> <remote> <branch> --squash
#
# To push local changes back upstream:
#   git subtree push --prefix=<path> <remote> <branch>
# =============================================================================

# --- Core: GitLab packaging + deployment ---
